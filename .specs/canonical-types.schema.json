{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lalela.senzo.io/schemas/canonical-types.schema.json",
  "title": "Lalela canonical types",
  "description": "Authoritative shapes for data Lalela writes to disk or receives from the Swift shim. In-memory-only types (AudioSource, TranscriptDraft, SavePlan, SavedPair) are defined in 01-domain-model.md and have no serialised form.",
  "$defs": {
    "TranscriptId": {
      "description": "Transcript identifier: 'trn_' followed by a lowercase hyphenated UUIDv7.",
      "type": "string",
      "pattern": "^trn_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Milliseconds": {
      "description": "Media time or duration in whole milliseconds. Bounded by AUDIO_DURATION_MS_MAX plus SEGMENT_END_TOLERANCE_MS.",
      "type": "integer",
      "minimum": 0,
      "maximum": 10801000
    },
    "UnixMilliseconds": {
      "description": "Wall-clock time as milliseconds since the Unix epoch, UTC.",
      "type": "integer",
      "minimum": 0
    },
    "Bytes": {
      "description": "A size in bytes. Call sites add their own bounds.",
      "type": "integer",
      "minimum": 0
    },
    "ProviderId": {
      "description": "Stable string form of the ProviderId enum.",
      "type": "string",
      "enum": ["apple-speech", "mistral-voxtral", "deepgram"]
    },
    "ModelName": {
      "description": "Provider model identifier as sent to the provider. Deliberately not checked against the current model list, so sidecars from retired models still decode.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "LanguageTag": {
      "description": "BCP-47 language tag: primary subtag with optional script and region subtags.",
      "type": "string",
      "maxLength": 16,
      "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
    },
    "LanguagePreference": {
      "description": "'auto' for provider detection, otherwise an explicit LanguageTag.",
      "oneOf": [
        { "const": "auto" },
        { "$ref": "#/$defs/LanguageTag" }
      ]
    },
    "SegmentText": {
      "description": "Trimmed, non-empty segment text. At most SEGMENT_TEXT_BYTES_MAX UTF-8 bytes (enforced in code; maxLength counts code points).",
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^\\S([^\\n\\r]*\\S)?$"
    },
    "Segment": {
      "description": "One timed span of speech. start_ms <= end_ms is enforced in code.",
      "type": "object",
      "required": ["start_ms", "end_ms", "text"],
      "additionalProperties": false,
      "properties": {
        "start_ms": { "$ref": "#/$defs/Milliseconds" },
        "end_ms": { "$ref": "#/$defs/Milliseconds" },
        "text": { "$ref": "#/$defs/SegmentText" }
      }
    },
    "AudioMetadata": {
      "description": "The saved audio file the sidecar belongs to, used to match a sidecar to its audio on reopen.",
      "type": "object",
      "required": ["file_name", "size_bytes", "duration_ms"],
      "additionalProperties": false,
      "properties": {
        "file_name": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/:\\u0000]+$" },
        "size_bytes": { "$ref": "#/$defs/Bytes", "minimum": 1, "maximum": 1073741824 },
        "duration_ms": { "$ref": "#/$defs/Milliseconds" }
      }
    },
    "TranscriptDocument": {
      "description": "The <stem>.transcript.json sidecar. Segment ordering, end-time bounds, and text == segments joined by '\\n' are enforced in code.",
      "type": "object",
      "required": ["schema_version", "id", "created_at_unix_ms", "audio", "provider", "model", "language", "text", "segments"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/TranscriptId" },
        "created_at_unix_ms": { "$ref": "#/$defs/UnixMilliseconds" },
        "audio": { "$ref": "#/$defs/AudioMetadata" },
        "provider": { "$ref": "#/$defs/ProviderId" },
        "model": { "$ref": "#/$defs/ModelName" },
        "language": {
          "oneOf": [ { "$ref": "#/$defs/LanguageTag" }, { "type": "null" } ]
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 4194304 },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20000,
          "items": { "$ref": "#/$defs/Segment" }
        }
      }
    },
    "SettingsDocument": {
      "description": "~/Library/Application Support/Lalela/settings.json. API keys are never stored here.",
      "type": "object",
      "required": ["schema_version", "output_folder", "provider", "models", "language"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "output_folder": {
          "oneOf": [ { "type": "string", "pattern": "^/" }, { "type": "null" } ]
        },
        "provider": { "$ref": "#/$defs/ProviderId" },
        "models": {
          "type": "object",
          "required": ["apple-speech", "mistral-voxtral", "deepgram"],
          "additionalProperties": false,
          "properties": {
            "apple-speech": { "$ref": "#/$defs/ModelName" },
            "mistral-voxtral": { "$ref": "#/$defs/ModelName" },
            "deepgram": { "$ref": "#/$defs/ModelName" }
          }
        },
        "language": { "$ref": "#/$defs/LanguagePreference" }
      }
    },
    "ShimSpeechOutput": {
      "description": "JSON written by lalela_speech_transcribe into the caller's buffer.",
      "type": "object",
      "required": ["locale", "segments"],
      "additionalProperties": false,
      "properties": {
        "locale": { "type": "string", "minLength": 2, "maxLength": 32 },
        "segments": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "type": "object",
            "required": ["start_ms", "end_ms", "text"],
            "additionalProperties": false,
            "properties": {
              "start_ms": { "$ref": "#/$defs/Milliseconds" },
              "end_ms": { "$ref": "#/$defs/Milliseconds" },
              "text": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
